<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_migration_wizard_form" model="ir.ui.view">
        <field name="name">migration.wizard.form</field>
        <field name="model">migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Migration Wizard">
                <sheet>
                    <group>
                        <field name="connection_id"/>
                        <field name="mode"/>
                    </group>
                    <group string="Data to Migrate">
                        <group>
                            <field name="migrate_partners"/>
                            <field name="migrate_categories"/>
                            <field name="migrate_products"/>
                            <field name="migrate_employees"/>
                            <field name="migrate_inventory"/>
                        </group>
                        <group>
                            <field name="migrate_crm"/>
                            <field name="migrate_projects"/>
                            <field name="migrate_sales"/>
                            <field name="migrate_purchases"/>
                        </group>
                    </group>
                    <group string="Last Run" invisible="not last_run_id">
                        <field name="last_run_id" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze" type="object" string="Dry Run / Preview"
                            class="btn-secondary"/>
                    <button name="action_migrate" type="object" string="Migrate"
                            class="btn-primary"
                            confirm="This will write data into this Odoo database. Continue?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_migration_wizard" model="ir.actions.act_window">
        <field name="name">Migration Wizard</field>
        <field name="res_model">migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
