<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_migration_connection_form" model="ir.ui.view">
        <field name="name">migration.connection.form</field>
        <field name="model">migration.connection</field>
        <field name="arch" type="xml">
            <form string="Migration Connection">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                    <button name="action_detect_version" type="object"
                            string="Detect Version" class="btn-secondary"/>
                    <button name="action_load_models" type="object"
                            string="Load Models" class="btn-secondary"/>
                    <button name="action_open_wizard" type="object"
                            string="Migrate Data" class="btn-primary"
                            invisible="state != 'tested'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tested"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Old Odoo 17 Production"/></h1>
                    </div>
                    <group>
                        <group string="Server">
                            <field name="url"/>
                            <field name="database"/>
                            <field name="transport"/>
                        </group>
                        <group string="Credentials">
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                    </group>
                    <group string="Status">
                        <field name="odoo_version"/>
                        <field name="last_test_result"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_migration_connection_list" model="ir.ui.view">
        <field name="name">migration.connection.list</field>
        <field name="model">migration.connection</field>
        <field name="arch" type="xml">
            <list string="Migration Connections">
                <field name="name"/>
                <field name="url"/>
                <field name="database"/>
                <field name="odoo_version"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_migration_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">migration.connection</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
