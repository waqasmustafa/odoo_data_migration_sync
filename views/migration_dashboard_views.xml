<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_migration_dashboard_form" model="ir.ui.view">
        <field name="name">migration.dashboard.form</field>
        <field name="model">migration.dashboard</field>
        <field name="arch" type="xml">
            <form string="Migration Dashboard">
                <div style="padding: 24px 32px; max-width: 1280px; background:#f7f7fa;">

                    <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22px;">
                        <div style="display:flex; align-items:flex-start; gap:12px;">
                            <div style="width:40px;height:40px;border-radius:10px;background:#eef0ff;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-exchange" style="font-size:17px;color:#4f46e5;"/>
                            </div>
                            <div>
                                <h1 style="margin:0; font-weight:700; font-size:22px; color:#1f2233;">Migration Dashboard</h1>
                                <div style="color:#8a8d99; font-size:13px; margin-top:2px;">
                                    Real-time overview of connections, runs and migrated records
                                </div>
                            </div>
                        </div>
                        <button name="action_refresh" type="object" string="Refresh"
                                icon="fa-refresh" class="btn-secondary"/>
                    </div>

                    <!-- KPI cards: 3 columns x 2 rows, icon badge + numbers -->
                    <div style="display:grid; grid-template-columns:repeat(3, minmax(220px,1fr)); gap:16px; margin-bottom:26px;">

                        <button name="action_view_connections" type="object"
                                style="text-align:left; border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                       padding:18px 20px; cursor:pointer; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                       display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#eef0ff;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-plug" style="font-size:18px;color:#4f46e5;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="connection_count" nolabel="1"/>
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Connections</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Configured source databases</div>
                            </div>
                        </button>

                        <button name="action_view_runs" type="object"
                                style="text-align:left; border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                       padding:18px 20px; cursor:pointer; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                       display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#f1f0ff;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-tasks" style="font-size:18px;color:#7c5cff;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="run_count" nolabel="1"/>
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Total Runs</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Dry-runs and migrations combined</div>
                            </div>
                        </button>

                        <button name="action_view_runs" type="object"
                                style="text-align:left; border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                       padding:18px 20px; cursor:pointer; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                       display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#e9f9ef;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-check-circle" style="font-size:18px;color:#1e9e4d;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="run_done_count" nolabel="1"/>
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Runs Done</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Completed successfully</div>
                            </div>
                        </button>

                        <button name="action_view_errors" type="object"
                                style="text-align:left; border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                       padding:18px 20px; cursor:pointer; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                       display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#fdecec;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-exclamation-triangle" style="font-size:18px;color:#d92d20;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="run_error_count" nolabel="1"/>
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Runs Failed</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Need attention</div>
                            </div>
                        </button>

                        <div style="border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                    padding:18px 20px; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                    display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#fff4e0;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-database" style="font-size:18px;color:#b5720a;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="total_created" nolabel="1"/> / <field name="total_updated" nolabel="1"/>
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Created / Updated</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Records written across all runs</div>
                            </div>
                        </div>

                        <div style="border:1px solid #e7e7ee; border-radius:12px; background:#ffffff;
                                    padding:18px 20px; box-shadow:0 1px 2px rgba(16,24,40,.04);
                                    display:flex; align-items:flex-start; gap:14px;">
                            <div style="width:44px;height:44px;border-radius:10px;background:#e9f9ef;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-line-chart" style="font-size:18px;color:#1e9e4d;"/>
                            </div>
                            <div>
                                <div style="font-size:24px; font-weight:700; color:#1f2233; line-height:1.2;">
                                    <field name="success_rate" nolabel="1" widget="float" digits="[0,1]"/>%
                                </div>
                                <div style="font-size:13px; font-weight:600; color:#374151; margin-top:2px;">Success Rate</div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:1px;">Created + Updated vs. Errors</div>
                            </div>
                        </div>

                    </div>

                    <!-- Recent runs -->
                    <div style="background:#ffffff; border:1px solid #e7e7ee; border-radius:12px; padding:18px 20px 6px;
                                box-shadow:0 1px 2px rgba(16,24,40,.04);">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                            <i class="fa fa-history" style="color:#6b6f7f;"/>
                            <span style="font-weight:700; color:#1f2233; font-size:14px;">Recent Runs</span>
                            <span style="color:#9ca3af; font-size:12.5px;">— latest 10</span>
                        </div>
                        <field name="recent_run_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="connection_id"/>
                                <field name="dry_run"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'done'"
                                       decoration-danger="state == 'error'"
                                       decoration-info="state == 'running'"/>
                                <field name="created_count"/>
                                <field name="updated_count"/>
                                <field name="error_count"/>
                                <field name="start_date"/>
                            </list>
                        </field>
                    </div>

                </div>
            </form>
        </field>
    </record>

    <record id="action_migration_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">migration.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
